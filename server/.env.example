# =============================================================================
# Facturacion-FE — server/.env
# Copiar:  copy .env.example .env
# =============================================================================
#
# PRODUCCIÓN (servidor del cliente / NSSM)
# ----------------------------------------
# 1. Raíz del repo:  npm install && npm run build   (crea dist/)
# 2. server/:         npm install
# 3. Editar .env: API_HOST, API_BASE_URL y CORS_ORIGIN deben usar el MISMO
#    hostname (o IP) y el MISMO puerto que PORT (3005).
#    Ejemplo si el equipo se llama "servidor":
#      API_HOST=servidor
#      API_BASE_URL=http://servidor:3005
#      CORS_ORIGIN=http://servidor:3005
# 4. URL para usuarios en red:  http://servidor:3005/views/login.html
# 5. Reiniciar servicios:  nssm restart FacturacionFE-API && nssm restart FacturacionFE-Worker
#
# NO en producción:
#   - Puerto 8080 (solo desarrollo con Vite)
#   - Servicio FacturacionFE-Web / npx serve
#   - npm run config:frontend (Express genera /env-config.js al vuelo desde este .env)
#
# DESARROLLO LOCAL (tu PC)
# ------------------------
# Raíz: npm run dev  (Vite, puerto 8080)  |  server/: npm run dev  (API, 3005)
# Usar:
#   API_HOST=localhost
#   API_BASE_URL=http://localhost:3005
#   CORS_ORIGIN=http://localhost:8080
#
# =============================================================================

PORT=3005

# --- Hostname / URL (elegir UN bloque) ---

# Producción en red LAN (reemplazar "servidor" por el nombre real del equipo):
# API_HOST=servidor
# API_BASE_URL=http://servidor:3005
# CORS_ORIGIN=http://servidor:3005

# Desarrollo local:
API_HOST=localhost
API_BASE_URL=http://localhost:3005
CORS_ORIGIN=http://localhost:8080

# Solo Vite en desarrollo (npm run dev). No es la URL de producción.
FRONTEND_PORT=8080

# Express sirve dist/ en PORT. Desactivar solo si la API va sin frontend estático.
# SERVE_FRONTEND=false

# SQL Server (misma BD que el proyecto PHP)
DB_SERVER=TUFF16\MSSQLSERVER2019
DB_NAME=CliniqReal
DB_USER=CeereRIPS
DB_PASSWORD=crsoft
# Timeout consultas SQL (ms). Default mssql=15000; worker necesita más
# DB_REQUEST_TIMEOUT_MS=60000
# DB_CONNECTION_TIMEOUT_MS=30000

# Autenticación JWT
JWT_SECRET=facturacion_fe_jwt_secret_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# Carpeta donde se guardan los XML (relativa a server/; por defecto ../xml)
# XML_OUTPUT_DIR=../xml

# Facturatech (CUFE + envío electrónico)
# FACTURATECH_USER=
# FACTURATECH_PASSWORD=
# FACTURATECH_WSDL_URL=https://ws.facturatech.co/v2/pro/index.php
# FACTURATECH_ENVIO_DELAY_MS=2000

# Modo FE: enviar | solo_xml
# solo_xml = solo genera/guarda XML (sin Facturatech ni UPDATE en BD)
FE_FACTURA_MODO=enviar
FE_NOTA_CREDITO_MODO=enviar

# Worker auto-envío (npm run worker)
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=60000
WORKER_MAX_PER_CYCLE=5
# Cuántas pendientes lee de BD por ciclo para saltar las en cooldown (default 50)
# WORKER_CANDIDATE_LIMIT=50
WORKER_DELAY_BETWEEN_MS=3000
WORKER_MAX_RETRIES_PER_WINDOW=2
WORKER_RETRY_WINDOW_MS=900000
WORKER_DORMANT_POLL_INTERVAL_MS=300000
# Control del worker desde la UI usa sc.exe (System32). Opcional: ruta a nssm.exe
# NSSM_EXE=C:\ruta\nssm.exe

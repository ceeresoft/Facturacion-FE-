# API (backend Node)
PORT=3005
# API_HOST=localhost
# API_BASE_URL=http://localhost:3005
#
# Acceso desde otros PCs en la red (el navegador del cliente abre esta URL):
#   API_HOST=leia
#   API_BASE_URL=http://leia:3005
#   CORS_ORIGIN=http://leia:3005
#
# Frontend compilado (npm run build en la raíz): Express sirve dist/ en el mismo puerto.
# SERVE_FRONTEND=false  desactiva el estático si solo quieres la API.
# SERVE_FRONTEND=true

# Vite en desarrollo (npm run dev en la raíz del repo, puerto 8080)
FRONTEND_PORT=8080
# FRONTEND_HOST=localhost
# Origen CORS del frontend en desarrollo (Vite). En producción con dist, usa la misma URL de la API.
CORS_ORIGIN=http://localhost:8080
# En red LAN con un solo puerto:
# CORS_ORIGIN=http://leia:3005

# SQL Server (misma BD que el proyecto PHP)
DB_SERVER=TUFF16\MSSQLSERVER2019
DB_NAME=CliniqReal
DB_USER=CeereRIPS
DB_PASSWORD=crsoft
# Timeout consultas SQL (ms). Default mssql=15000; worker necesita más
# DB_REQUEST_TIMEOUT_MS=60000
# DB_CONNECTION_TIMEOUT_MS=30000

# Autenticación JWT
JWT_SECRET=facturacion_fe_jwt_secret_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# Carpeta donde se guardan los XML (relativa a server/; por defecto ../xml)
# XML_OUTPUT_DIR=../xml

# Facturatech (CUFE + envío electrónico)
# FACTURATECH_USER=
# FACTURATECH_PASSWORD=
# FACTURATECH_WSDL_URL=https://ws.facturatech.co/v2/pro/index.php
# FACTURATECH_ENVIO_DELAY_MS=2000

# Modo FE: enviar | solo_xml
# solo_xml = solo genera/guarda XML (sin Facturatech ni UPDATE en BD)
FE_FACTURA_MODO=enviar
FE_NOTA_CREDITO_MODO=enviar

# Worker auto-envío (npm run worker)
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=60000
WORKER_MAX_PER_CYCLE=5
# Cuántas pendientes lee de BD por ciclo para saltar las en cooldown (default 50)
# WORKER_CANDIDATE_LIMIT=50
WORKER_DELAY_BETWEEN_MS=3000
WORKER_MAX_RETRIES_PER_WINDOW=2
WORKER_RETRY_WINDOW_MS=900000
WORKER_DORMANT_POLL_INTERVAL_MS=300000
# Control del worker desde la UI usa sc.exe (System32). Opcional: ruta a nssm.exe
# NSSM_EXE=C:\ruta\nssm.exe
